OPERATING_SYSTEM=Canonical Ubuntu
OS_VERSION=22.04 Minimal aarch64
ASSIGN_PUBLIC_IP=true

# Subnet hien co trong VCN cua ban o Tokyo
OCI_SUBNET_ID=ocid1.subnet.oc1.ap-tokyo-1.aaaaaaaahaglsizxvylx7keccc3assvzwite7ljzazifosxxnzsqumccfyma

SSH_AUTHORIZED_KEYS_FILE=./id_rsa.pub
DISCORD_WEBHOOK=

